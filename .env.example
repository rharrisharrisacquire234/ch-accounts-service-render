# Copy to .env and fill in. Never commit .env.
CH_API_KEY=
# Long random string, e.g. the output of: openssl rand -hex 32
API_TOKEN=

# Sizing for the VPS. OCR_CPUS must not exceed the number of vCPUs.
OCR_CPUS=2
OCR_MEMORY=3G
OCR_WORKERS=2
MAX_JOBS=1
CACHE_DAYS=30

# 127.0.0.1 keeps the service private to the VPS. See DEPLOY.md.
BIND=127.0.0.1
PORT=8080

# Only for compose.n8n.yaml
# N8N_NETWORK=
